parking=[]
print("\n 1.car Entry(Enqueu)")
print("2.car exit(dequeu)")
print("3.display cars")
print("4.Exit")
while True:
    choice=int(input("Enter your choice: "))
    if choice==1:
        car=input("Enter car number: ")
        parking.append(car)
        print("car parked:",car)
    elif choice==2:
        if len(parking)==0:
            print("parking is empty")
        else:
            car=parking.pop(0)
            print("car exited: ",car)
    elif choice==3:
        if len(parking)==0:
            print("Parking is empty")
        else:
            print("parked cars: ")
            for car in parking:
                print(car)
    elif choice==4:
        print("Exit")
        break
    else:
        print("Invalid choice")
