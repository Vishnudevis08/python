class Node:
    def __init__(self,coeffi,power):
        self.coeffi=coeffi
        self.power=power
        self.next=None
class Polynomial:
    def __init__(self):
        self.head=None
    def insert(self,coeffi,power):
        new_node=Node(coeffi,power)
        if self.head is None or self.head.power<power:
            new_node.next=self.head
            self.head=new_node
            return
        temp=self.head
        while temp.next and temp.next.power>power:
            temp=temp.next
        if temp.next and temp.next.power==power:
            temp.next.coeff+=coeffi
        elif temp.power==power:
            temp.coeffi+=coeffi
        else:
            new_node.next=temp.next
            temp.next=new_node
    def add(poly1,poly2):
        p=poly1.head
        q=poly2.head
        result=Polynomial()
        while p and q:
            if p.power==q.power:
                result.insert(p.coeffi+q.coeffi,p.power)
                p=p.next
                q=q.next
            elif p.power>q.power:
                result.insert(p.coeffi,p.power)
                p=p.next
            else:
                result.insert(q.coeffi,q.power)
                q=q.next
        while p:
            result.insert(p.coeffi,p.power)
            p=p.next
        while q:
            result.insert(q.coeffi,q.power)
            q=q.next
        return result
    def display(self):
        if self.head is None:
            print("0")
            return
        temp=self.head
        while temp:
            print(f"{temp.coeffi}x^{temp.power}",end="")
            if temp.next:
                print("+",end=" ")
            temp=temp.next
        print()
poly1=Polynomial()
poly2=Polynomial()
